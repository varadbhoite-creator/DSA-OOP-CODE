import java.util.*;
class Demo{

	public static void main(String[]args){

		int arr[]={9,8,7,6,5};
		int len=arr.length;
		int left=0;
		int right=len-1;

		while(left<right){

			int temp=arr[left];
			arr[left]=arr[right];
			arr[right]=arr[left];
		}
		System.out.println(Arrays.toString(arr));
	}
}